# Copy to .env and fill in. Never commit .env.
JIRA_BASE_URL=https://your-site.atlassian.net
ATLASSIAN_EMAIL=you@example.com
ATLASSIAN_API_TOKEN=create-one-at-id.atlassian.com/manage-profile/security/api-tokens
JIRA_PROJECT=SUP
CONFLUENCE_SPACE_KEY=SUP

# keyword (no AI) | deepseek | ollama (local model) | openai (any OpenAI-compatible API)
CLASSIFIER=deepseek
# Leave empty to use the classifier's default (deepseek: https://api.deepseek.com + deepseek-flash)
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=your-deepseek-key
